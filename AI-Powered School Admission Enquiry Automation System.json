        "jsCode": "const enquiry = $('Receive Admission Enquiry').first().json.body || {};\n\nconst error = $json.error || {};\n\nreturn {\n  json: {\n    parent_name: enquiry.parent_name || '',\n    phone: enquiry.phone || '',\n    email: enquiry.email || '',\n    child_class: enquiry.child_class || '',\n    message: enquiry.message || '',\n\n    category: 'Other',\n    urgency: 'Medium',\n\n    reason: 'Gemini API failed. Manual review required.',\n    reply: '',\n\n    review_status: 'Pending Review',\n    email_status: enquiry.email ? 'Pending Review' : 'Missing Email',\n    telegram_alert: false,\n\n    error_message: error.message || $json.message || 'Gemini API Error'\n  }\n};"
